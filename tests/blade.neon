includes:
    - ../vendor/larastan/larastan/extension.neon
    - ../vendor/tomasvotruba/bladestan/config/extension.neon
    - ../extension.neon

parameters:
    viewDirectories:
        # this path is relative to the CWD?
        - ./tests/resources
    lostInTranslation:
        # These tests exercise Bladestan's wrapper directly; e2e tests exercise the diagnostic bridge.
        bridgeBladeDiagnostics: false
        langPath: tests/lang
