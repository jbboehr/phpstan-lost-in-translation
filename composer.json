{
    "name": "jbboehr/phpstan-lost-in-translation",
    "description": "PHPStan extension for validating Laravel translation keys, replacements, choices, locales, files, and Blade usage",
    "type": "phpstan-extension",
    "keywords": ["laravel", "larastan", "bladestan", "phpstan", "php", "package", "static analysis", "code analysis", "code analyse"],
    "license": "AGPL-3.0-only WITH romic-exception",
    "homepage": "https://github.com/jbboehr/phpstan-lost-in-translation",
    "support": {
        "issues": "https://github.com/jbboehr/phpstan-lost-in-translation/issues",
        "source": "https://github.com/jbboehr/phpstan-lost-in-translation"
    },
    "authors": [
        {
            "name": "John Boehr",
            "email": "jbboehr@gmail.com"
        }
    ],
    "archive": {
        "exclude": [
            "/.codex",
            "/.codeclimate.json",
            "/.direnv",
            "/.dvc",
            "/.editorconfig",
            "/.envrc",
            "/.gitattributes",
            "/.github",
            "/.gitignore",
            "/.idea",
            "/.php-cs-fixer.cache",
            "/.phpcs.xml.dist",
            "/.php-cs-fixer.dist.php",
            "/.phpunit.result.cache",
            "/.pre-commit-config.yaml",
            "/AGENTS.md",
            "/build",
            "/clover.xml",
            "/composer.lock",
            "/coverage",
            "/docs/book.toml",
            "/docs/code-review-remediation-plan.md",
            "/docs/development",
            "/docs/mutation-testing.md",
            "/docs/theme",
            "/e2e",
            "/flake.lock",
            "/flake.nix",
            "/infection.json5.dist",
            "/nix",
            "/*.log",
            "/phpbench.json",
            "/phpbench.perfidious.json",
            "/phpstan-strict-rules.php",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/result*",
            "/secrets",
            "/tests",
            "/tmp*",
            "/tools",
            "/vendor"
        ]
    },
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "salsify/json-streaming-parser": "^8.3",
        "symfony/finder": "^6 || ^7",
        "symfony/intl": "^6 || ^7"
    },
    "autoload": {
        "psr-4": {
            "jbboehr\\PHPStanLostInTranslation\\": "src/"
        }
    },
    "require-dev": {
        "composer-runtime-api": "*",
        "brick/varexporter": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "jbboehr/doctrine-of-the-second-sun": "dev-master",
        "jbboehr/phpbench-perfidious": "dev-master",
        "larastan/larastan": "^2.11 || ^3.4",
        "laravel/framework": "^9 || ^10 || ^11 || ^12 || ^13",
        "orchestra/testbench": "^7.55 || ^8.36 || ^9.14 || ^10.3 || ^11.0",
        "phpbench/phpbench": "^1.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^1.2.1 || ^2.0",
        "phpstan/phpstan-phpunit": "^1.4.2 || ^2.0.6",
        "phpstan/phpstan-strict-rules": "^1.6.2 || ^2.0.4",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "slevomat/coding-standard": "^8.18",
        "squizlabs/php_codesniffer": "^3.13",
        "tomasvotruba/bladestan": ">=0.6",
        "webmozart/assert": "^1.11"
    },
    "autoload-dev": {
        "psr-4": {
            "jbboehr\\PHPStanLostInTranslation\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "phpstan/extension-installer": false
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "analyse": "./vendor/bin/phpstan analyse",
        "benchmark": "./vendor/bin/phpbench run --progress=none --report=aggregate",
        "benchmark:perfidious": "./vendor/bin/phpbench run --config=phpbench.perfidious.json --progress=none --report=perfidious",
        "benchmark:perfidious:hardware": "./vendor/bin/phpbench run --config=phpbench.perfidious.json --profile=hardware --progress=none --report=perfidious",
        "benchmark:smoke": "./vendor/bin/phpbench run --iterations=1 --revs=1 --warmup=1 --progress=none",
        "bookstack:canary": "tools/bookstack/run",
        "check": [
            "@composer validate --strict",
            "@check:whitespace",
            "@php-cs-fixer",
            "@phpcs",
            "@analyse",
            "@test"
        ],
        "check:full": [
            "@check",
            "@runtime-smoke",
            "@package:check",
            "@e2e",
            "@benchmark:smoke"
        ],
        "check:whitespace": "git diff HEAD --check",
        "coverage": "./vendor/bin/phpunit --coverage-filter src --coverage-clover clover.xml --coverage-text",
        "docs:check": [
            "@docs:validate",
            "@docs:install",
            "@docs:analyse",
            "@docs:test",
            "@docs:build",
            "@docs:links"
        ],
        "docs:analyse": "composer --working-dir=tools/akashi analyse",
        "docs:build": "mdbook build docs",
        "docs:install": "composer --working-dir=tools/akashi install --prefer-dist --no-progress",
        "docs:links": "@php tools/docs/check-generated-links.php build/docs",
        "docs:serve": "mdbook serve docs",
        "docs:test": "composer --working-dir=tools/akashi test",
        "docs:validate": "composer --working-dir=tools/akashi validate --strict",
        "e2e": "./vendor/bin/phpstan analyse --configuration=e2e/phpstan-e2e.neon --error-format=json  | ./e2e/test-runner",
        "e2e-debug": "./vendor/bin/phpstan analyse --configuration=e2e/phpstan-e2e.neon --debug --error-format=blade || true",
        "eris": [
            "@eris:validate",
            "@eris:install",
            "@eris:test"
        ],
        "eris:install": "composer --working-dir=tools/eris install --prefer-dist --no-progress",
        "eris:test": "composer --working-dir=tools/eris test",
        "eris:validate": "composer --working-dir=tools/eris validate --strict",
        "infection": "infection --no-progress",
        "infection:ci": "infection --no-progress",
        "infection:core": "infection --no-progress src/TranslationLoader src/CallRule src/LostInTranslationHelper.php src/Utils.php",
        "package:check": "@php tools/check-package.php",
        "phpcs": "./vendor/bin/phpcs",
        "php-cs-fixer": "./vendor/bin/php-cs-fixer check --diff --show-progress=none --using-cache=no",
        "phpstan": "./vendor/bin/phpstan",
        "phpunit": "./vendor/bin/phpunit",
        "runtime-smoke": "@php tests/runtime-smoke/run.php",
        "test": "./vendor/bin/phpunit --no-coverage"
    },
    "_comment": [
        "Think not that I am come to send peace on earth: I came not to send peace, but a sword. Matthew 10:34"
    ]
}
